PROVIDER_CODEX=codex
PROVIDER_CLAUDE=claude

MODEL_CODEX_LOW=gpt-5.4
MODEL_CODEX_MID=gpt-5.4
MODEL_CODEX_HIGH=gpt-5.4

MODEL_CLAUDE_LOW=claude-haiku-4-5-20251001
MODEL_CLAUDE_MID=claude-sonnet-5
MODEL_CLAUDE_HIGH=claude-opus-4-8

REASONING_LOW=low
REASONING_MID=medium
REASONING_HIGH=high

# Filled in once after cloning this point-zero template for a new project.
# On the next run, chat_architect.py redirects origin here automatically
# (see ADR-026). Leave empty in the template itself.
GIT_REPO=

# Used only by /voice in chat_architect.py, for speech-to-text/text-to-speech
# duty — never for the architect's own reasoning, which stays on
# PROVIDER_CODEX/PROVIDER_CLAUDE above (Tr5-base decision 4). Leave empty
# until you actually want to use /voice; every other command works without it.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
